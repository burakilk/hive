{
  "name": "hive",
  "productName": "Hive",
  "version": "0.4.6",
  "description": "Run multiple AI coding agents (Claude Code, Codex, Gemini...) side by side",
  "main": "./out/main/index.js",
  "author": "Fatih Burak İlk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "app": "node scripts/install-app.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "dev.hive.app",
    "productName": "Hive",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hive uses the microphone for voice dictation of prompts.",
        "NSScreenCaptureUsageDescription": "Hive captures screenshots you attach to prompts."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "burakilk",
        "repo": "hive",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-windows-setup.${ext}"
    },
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/burakilk/hive.git"
  },
  "homepage": "https://github.com/burakilk/hive"
}
